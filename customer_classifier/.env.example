# ──────────────────────────────────────────────────────────────
# Amazon Redshift 접속 정보 (DB 직접 연결 시에만 필요)
#
# 사용법:
#   1) 이 파일을 같은 폴더에 ".env" 라는 이름으로 복사하세요.
#        Windows(PowerShell):  Copy-Item .env.example .env
#        Mac/Linux:            cp .env.example .env
#   2) 아래 값을 실제 접속 정보로 채우세요.
#   3) .env 파일은 절대 GitHub·메신저·이메일에 올리지 마세요.
#      (.gitignore 에 의해 버전관리에서 자동 제외됩니다)
#
# ※ 파일 업로드(CSV/Excel)로만 사용할 경우 이 파일은 필요 없습니다.
# ──────────────────────────────────────────────────────────────

# Redshift 호스트 주소 (예: my-cluster.abc123.ap-northeast-2.redshift.amazonaws.com)
RS_HOST=

# 포트 번호 (Redshift 기본값 5439)
RS_PORT=5439

# 데이터베이스 이름
RS_DATABASE=

# 접속 계정 — 분석용 읽기 전용(SELECT) 계정 권장
RS_USER=

# 비밀번호
RS_PASSWORD=
