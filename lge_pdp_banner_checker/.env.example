# Redshift 접속 정보 (필수)
REDSHIFT_HOST=your-redshift-cluster.xxxxxx.ap-northeast-2.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=your_database
REDSHIFT_USER=your_user
REDSHIFT_PASSWORD=your_password

# 선택 옵션
REDSHIFT_SSL=true

# 점검 도구 기본값
DEFAULT_OUTPUT_DIR=outputs
DEFAULT_CONCURRENCY=3
DEFAULT_TIMEOUT_MS=30000

# 점검 대상 배너 이미지 경로 (운영 캠페인에 맞게 변경)
BANNER_IMAGE_PATH=/kr/home-main-pdp/2026/JUN/pdp_banner_656x220.png
