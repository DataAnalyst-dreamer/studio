# Redshift 접속 정보 (필수)
REDSHIFT_HOST=your-redshift-cluster.xxxxxx.ap-northeast-2.redshift.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DATABASE=your_database
REDSHIFT_USER=your_user
REDSHIFT_PASSWORD=your_password

# 선택 옵션
REDSHIFT_SSL=true
# SSL 검증 모드: verify-ca(기본) 또는 verify-full
REDSHIFT_SSLMODE=verify-ca
# 사내 보안장비(TLS 가로채기) 환경에서 'self-signed certificate in chain' 오류가
# 날 경우, 아래 중 하나를 사용한다.
#  1) (권장) 사내 루트 CA 번들(.pem) 경로 지정 → 검증 유지
# REDSHIFT_CA_BUNDLE=/path/to/corp-root-ca.pem
#  2) (사내 QA 한정, 비권장) 인증서 검증 우회. 암호화는 유지, 신원검증은 생략
# REDSHIFT_SSL_INSECURE=false
#  3) 클러스터가 평문 접속을 허용하면 SSL 자체를 끈다
# REDSHIFT_SSL=false

# 점검 도구 기본값
DEFAULT_OUTPUT_DIR=outputs
DEFAULT_CONCURRENCY=3
DEFAULT_TIMEOUT_MS=30000

# 점검 대상 배너 이미지 경로 (운영 캠페인에 맞게 변경)
BANNER_IMAGE_PATH=/kr/home-main-pdp/2026/JUN/pdp_banner_656x220.png
